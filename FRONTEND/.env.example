# SupportDesk Frontend — Environment Configuration Template
# Copy this file to .env and configure as needed.

VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── WebRTC TURN Server Configuration (L-03) ──────────────────────────────────
# Optional: STUN is enabled by default. Provide TURN settings for restrictive firewalls/NAT.
# Supports single URL, comma-separated URLs, or JSON array format. Supports turn: and turns: protocols.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
