# SupportDesk Backend — Environment Configuration Template
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to version control. This file (.env.example) IS safe to commit.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# Use a MongoDB Atlas connection string or a local URI with authentication.
# NEVER use mongodb://localhost without credentials in production.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supportdesk?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 256 bits (64 hex characters). Must NEVER be committed or hardcoded.
JWT_SECRET=<generate-a-strong-secret>
JWT_EXPIRES_IN=1d

# ─── CORS (L-02) ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (applies to both REST API and Socket.IO).
# Example: http://localhost:5173,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ─── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<your-gmail-app-password>
FROM_EMAIL=<your-email@gmail.com>
